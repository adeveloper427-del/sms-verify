# Copy this file to ".env" (same folder) and fill it in. Then restart `npm run dev`.
# NEVER put the service_role key or the Africa's Talking API key in this file —
# everything here ends up in the browser.

# true  = offline demo data (no setup needed)
# false = real Supabase database
VITE_USE_MOCK_API=false

# Supabase → Project Settings → API (or "Connect")
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon public" key (or the "publishable" key, starts with sb_publishable_)
VITE_SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here
